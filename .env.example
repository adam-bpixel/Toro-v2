DISCORD_TOKEN=your-bot-token-here

# Application (client) ID - optional, auto-detected from the token if left unset
DISCORD_CLIENT_ID=your-application-id-here

# MongoDB URI
MONGODB_URI=mongodb://127.0.0.1:27017

# Global logs webhook
GLOBAL_LOGS_WEBHOOK_URL=https://discord.com/api/webhooks/your-webhook-id/your-webhook-token

# Support reports channel
REPORT_CHANNEL_ID=your-channel-id

# Image re-host webhook
TICKET_IMAGE_WEBHOOK_URL=https://discord.com/api/webhooks/your-webhook-id/your-webhook-token

# Owner Discord ID(s), comma-separated
OWNER_ID=your-discord-id

# Support server invite
SUPPORT_SERVER=https://discord.gg/KkH2zAxfWQ

# Default prefix
DEFAULT_PREFIX=&

# Upload all emoji once, then restart
SYNC_EMOJIS=false

# Use bot's avatar as brand emoji, then restart
USE_BOT_AVATAR_LOGO=false
