{
  "name": "discord-bot",
  "version": "1.0.0",
  "description": "A full-featured, self-hosted Discord bot built with discord.js",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "lint": "eslint .",
    "test": "node --test test/",
    "check": "npm run lint && npm test",
    "deploy": "node deploy-commands.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@discordjs/voice": "^0.18.0",
    "@napi-rs/canvas": "^0.1.53",
    "discord.js": "^14.16.0",
    "dotenv": "^16.4.5",
    "figlet": "^1.11.4",
    "gifwrap": "^0.10.1",
    "gradient-string": "^2.0.2",
    "mongodb": "^6.9.0",
    "tweetnacl": "^1.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "eslint": "^9.39.1",
    "globals": "^16.5.0"
  }
}
